types NEW_TOOLTIPS {
	type new_tooltip_text_area = textbox {
		using = BaseFontS
		align = left
		autoresize = yes
		alwaystransparent = no
		multiline = yes
		max_width = 400
		fonttintcolor = "[TooltipInfo.GetTintColor]"
	}
	type building_tooltip = flowcontainer {
		alwaystransparent = no 
		ignoreinvisible = yes
		filter_mouse = all
		using = tooltip_background
		widget = {
			block "ImageVisible" { visible = yes }
			icon = {
				size = { 200 200 }
				position = { 2 2 }
				block "Image" { texture = "[GetBuildingIcon( BuildingItem.GetBuilding )]" }
				using = portrait_x32y32bd_alpha
				alpha = 0.35
				modify_texture = {
					texture = "gfx/interface/base_parts/horizontal_gradient_stretch.dds"
					blend_mode = alphamultiply
				}
				modify_texture = {
					texture = "gfx/interface/base_parts/gradient_black.dds"
					blend_mode = alphamultiply
				}
			}
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 20 0 }
			margin_top = 15
			block "header_tt" {}
			block "header_additions" {}
			margin_widget = {
				name = "title_container"
				size = { 400 45 }
				
				flowcontainer = {
					name = "FancyHeader"
					alwaystransparent = no
					ignoreinvisible = yes
					direction = vertical

					normal_text = {
						name = "title"
						autoresize = yes
						margin_bottom = 2
						max_width = 400
						fontsize_min = 14
						using = BaseFontM
						align = left
						block "title_text" { text = "tooltip_building_title" }
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					
					flowcontainer = {
						spacing = 4
						block "ConceptLinkPreVisibility" { }
						normal_text = {
							name = "concept_link_pre"
							autoresize = yes
							text = "READ_MORE_ABOUT"
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
						normal_text = {
							name = "concept_link"
							autoresize = yes
							block "concept_link" { text = "[building]" }
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
					}
				}
			}
			flowcontainer = {
				direction = vertical
				spacing = 5
				new_tooltip_text_area = {
					block "description" { text = "[BuildingItem.GetBuilding.GetDescription]" }
				}
				widget = {
					size = { 100% 2 }
					widget = {
						size = { 100% 6 }
						parentanchor = center
						using = brown_underline
					}
				}
				block "extra_data" {}
			}
			textbox = {
				name = "BottomText"
			
				using = GameConceptFlavorTooltipText
				multiline = yes
				block "bottom_text" { text = "tooltip_building_bottom" }
				fonttintcolor = "[TooltipInfo.GetTintColor]"
				alwaystransparent = no
				elide = right
				max_width = 400
			}
			textbox = {
				name = "TooltipTextShortcut"
				using = DefaultTooltipText
				parentanchor = right
				margin = { 10 10 }
				block "Cull" { visible = yes }
			}
		}
		margin_widget = {
			size = { 22 100% }
			margin = { 0 6 }
			using = ProgressLockIndicator
		}
	}
	type new_building_tooltip_pop_out = flowcontainer {
		alwaystransparent = no 
		ignoreinvisible = yes
		filter_mouse = all
		using = tooltip_background
		widget = {
			margin_widget = {
				size = { 64 64 }
				position = { 372 10 }
				margin = { 3 3 }
				background = {
					shaderfile = "gfx/FX/pdxgui_default.shader"
					using = portrait_x32y32bd_alpha
					block "IconTexture" { 
						#texture = "gfx/interface/icons/_default.dds"
					}
					spriteType = Corneredtiled
					framesize = { 1 1 }
					frame = 1
					alpha = 0.5
				}
				background = {
					shaderfile = "gfx/FX/pdxgui_default.shader"
					using = portrait_x32y32bd_alpha
					using = beige_background
					alpha = 0.5
					modify_texture = {
						texture = "gfx/interface/base_parts/button_vignette.dds"
						blend_mode = alphamultiply
						spriteType = corneredtiled
						spriteborder = { 20 20 }
					}
				}
				widget = {
					size = { 100% 100% }
					background = {
						name = "Shadow"
						texture = "gfx/interface/base_parts/button_square_dropshadow_x16y16bd.dds"
						shaderfile = "gfx/FX/pdxgui_default.shader"
						spriteType = corneredtiled
						spriteborder = { 8 8 }
						margin = { 3 3 }
						alpha = 0.5
					}
				}
				widget = {
					size = { 100% 100% }
					background = {
						shaderfile = "gfx/FX/pdxgui_default.shader"
						using = portrait_x32y32bd_alpha
						block "IconTexture" { 
							#texture = "gfx/interface/icons/_default.dds"
						}
					}
					background = {
						shaderfile = "gfx/FX/pdxgui_default.shader"
						using = black_background
						using = portrait_x32y32bd_alpha
						alpha = 0.5
						modify_texture = {
							texture = "gfx/interface/base_parts/horizontal_gradient_stretch_inverted.dds"
							blend_mode = alphamultiply
						}
						modify_texture = {
							texture = "gfx/interface/base_parts/gradient_black_flip.dds"
							blend_mode = alphamultiply
						}
					}
					background = {
						shaderfile = "gfx/FX/pdxgui_default.shader"
						using = portrait_x32y32bd_alpha
						using = beige_background
						alpha = 0.5
						modify_texture = {
							texture = "gfx/interface/base_parts/gradient_black_flip.dds"
							blend_mode = alphamultiply
						}
					}
					background = {
						shaderfile = "gfx/FX/pdxgui_default.shader"
						using = portrait_x32y32bd_alpha
						using = black_background
						alpha = 0.5
						modify_texture = {
							texture = "gfx/interface/base_parts/button_vignette.dds"
							blend_mode = alphamultiply
							spriteType = corneredtiled
							spriteborder = { 20 20 }
						}
					}
				}
			}
		}
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 20 0 }
			margin_top = 15
			block "header_tt" {}
			block "header_additions" {}
			margin_widget = {
				name = "title_container"
				size = { 400 45 }
				
				flowcontainer = {
					name = "FancyHeader"
					alwaystransparent = no
					ignoreinvisible = yes
					direction = vertical

					normal_text = {
						name = "title"
						autoresize = yes
						margin_bottom = 2
						max_width = 400
						fontsize_min = 14
						using = BaseFontM
						align = left
						block "title_text" {}
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					
					flowcontainer = {
						spacing = 4
						block "ConceptLinkPreVisibility" {}
						normal_text = {
							name = "concept_link_pre"
							autoresize = yes
							text = "READ_MORE_ABOUT"
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
						normal_text = {
							name = "concept_link"
							autoresize = yes
							block "concept_link" {
								text = "#D TODO#!"
							}
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
					}
				}
			}
			flowcontainer = {
				direction = vertical
				spacing = 5
				block "extra_data" { }
			}
			textbox = {
				name = "TooltipTextShortcut"
				using = DefaultTooltipText
				parentanchor = right
				margin = { 10 10 }
				block "Cull" { visible = yes }
			}
		}
		margin_widget = {
			size = { 22 100% }
			margin = { 0 6 }
			using = ProgressLockIndicator
		}
	}
	type religion_tooltip = flowcontainer {
		alwaystransparent = no 
		ignoreinvisible = yes
		filter_mouse = all
		using = tooltip_background
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 20 0 }
			margin_top = 15
			block "header_tt" {}
			block "header_additions" {}
			margin_widget = {
				name = "title_container"
				size = { 400 65 }
				
				flowcontainer = {
					name = "FancyHeader"
					alwaystransparent = no
					ignoreinvisible = yes
					direction = vertical
					flowcontainer = {
						religion = {
							blockoverride "size" { size = { 40 40 } }
							blockoverride "datacontext" { }
							parentanchor = left
						}
						normal_text = {
							name = "title"
							autoresize = yes
							margin_bottom = 2
							margin_left = 5
							max_width = 400
							fontsize_min = 14
							using = BaseFontM
							align = left
							parentanchor = vcenter
							block "title_text" {}
							fonttintcolor = "[TooltipInfo.GetTintColor]"
						}
					}
					flowcontainer = {
						spacing = 4
						block "ConceptLinkPreVisibility" {}
						normal_text = {
							name = "concept_link_pre"
							autoresize = yes
							text = "READ_MORE_ABOUT"
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
						normal_text = {
							name = "concept_link"
							autoresize = yes
							block "concept_link" {
								text = "#D TODO#!"
							}
							using = TooltipConceptFont
							alwaystransparent = yes
							multiline = no
							fontsize = 14
							max_width = 200
						}
					}
				}
			}
			flowcontainer = {
				direction = vertical
				spacing = 5
				block "extra_data" { }
			}
			textbox = {
				name = "TooltipTextShortcut"
				using = DefaultTooltipText
				parentanchor = right
				margin = { 10 10 }
				block "Cull" { visible = yes }
			}
		}
		margin_widget = {
			size = { 22 100% }
			margin = { 0 6 }
			using = ProgressLockIndicator
		}
	}
	type base_table_tt = flowcontainer {
		alwaystransparent = no 
		ignoreinvisible = yes
		filter_mouse = all
		using = tooltip_background
		flowcontainer = {
			direction = vertical
			ignoreinvisible = yes
			margin = { 0 15 }
			margin_left = 15
			block "centent" { }
		}
		margin_widget = {
			size = { 22 100% }
			margin = { 0 6 }
			using = ProgressLockIndicator
		}
	}
	type wealth_information_tt = base_table_tt {
		blockoverride "centent" {
			flowcontainer = {
				icon = {
					size = { 28 28 }
					block "icon" { }
				}
				textbox = {
					size = { 150 34 }
					align = hcenter|top
					elide = right
					using = BaseFontL
					using = Default_FontColor
					block "name" { }
				}
				textbox = {
					size = { 150 34 }
					align = hcenter|top
					elide = right
					using = BaseFontL
					using = Default_FontColor
					text = "| Per capita:"
				}
				textbox = {
					size = { 64 34 }
					align = left|top
					elide = right
					using = BaseFontL
					using = Default_FontColor
					block "per_capita" { }
				}
			}
			flowcontainer = {
				direction = horizontal
				margin_left = -1
				text_button_sort = {
					size = { 201 32 }
					blockoverride "Button_text" { text = "wi_tt_category" }
					blockoverride "Icon" { visible = no }
					blockoverride "Drop_shadow" { visible = no }
				}
				text_button_sort = {
					size = { 100 32 }
					blockoverride "Button_text" { text = "wi_tt_income" }
					blockoverride "Icon" { visible = no }
					blockoverride "Drop_shadow" { visible = no }
				}
				text_button_sort = {
					size = { 100 32 }
					blockoverride "Button_text" { text = "wi_tt_outgoings" }
					blockoverride "Icon" { visible = no }
					blockoverride "Drop_shadow" { visible = no }
				}
			}
			string_wealth_information = {
				blockoverride "background" {
					using = beige_background_tooltip
				}
				blockoverride "cell_1" { text = "wi_tt_total" }
				blockoverride "cell_2" { block "income" { } }
				blockoverride "cell_3" { block "expenses" { } }
			}
			cell_wealth_information = {
				blockoverride "text" {
					size = { 400 28 }
					align = center
					text = "wi_tt_trade"
				}
			}
			string_wealth_information = {
				blockoverride "cell_1" { text = "wi_tt_raw_resources" }
