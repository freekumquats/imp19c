			province_two_cells_tgw = {
				blockoverride "cell_1" { text = "tgv_tt_centralisation" }
				blockoverride "cell_2" { text = "¥[ProvinceWindow.GetState.GetGovernorship.MakeScope.GetVariable('WEALTH_empire_pool_owed_governorship').GetValue|3+=]" }
			}
			province_two_cells_tgw = {
				blockoverride "background" {
					using = beige_background_tooltip
				}
				blockoverride "cell_1" { text = "tgv_tt_average_wage" }
				blockoverride "cell_2" { text = "#L [ProvinceWindow.GetProvince.GetOwner.MakeScope.GetVariable('WEALTH_average_wage_wealth_value').GetValue|3+=]#!" }
			}
		}
	}
	type nation_treasury_tt = base_table_tt {
		blockoverride "centent" {
			cell_wealth_information = {
				blockoverride "text" {
					size = { 300 28 }
					align = center
					text = "topbar_tt_quarter_gi"
				}
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_tr" }
				blockoverride "cell_2" { text = "[GuiScope.SetRoot( Player.MakeScope ).ScriptValue('INCOME_national_total_from_tax')|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_tas" }
				blockoverride "cell_2" { text = "[GuiScope.SetRoot( Player.MakeScope ).ScriptValue('INCOME_national_total_from_tariffs_and_shipping')|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_sop" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_national_total_production').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_sd" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_national_total_from_subjects').GetValue|3+=]" }
			}
			# [fix, task #4 2026-08-16] State monopolies & customs and One-off windfalls were both
			# defined in a completely separate, dead loc string (imp19c_nation_treasury_tooltip --
			# confirmed unreferenced by any .gui file) that three prior fix attempts edited without
			# ever touching THIS widget, the one actually bound to the topbar's hover tooltip
			# (gui/ingame_topbar.gui -> nation_treasury_tt, this template). Added both real rows here.
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_smc" }
				blockoverride "cell_2" { text = "[GuiScope.SetRoot( Player.MakeScope ).ScriptValue('INCOME_national_total_from_qing_revenue')|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_quarter_fdi" }
				blockoverride "cell_2" { text = "#D TODO" }
			}
			string_income_information = {
				# [fix 2026-08-23] this row often showed a large, unexplained number with no context --
				# it's a real income line (add_treasury calls from one-shot events: marriage dowries,
				# treasure fleets, decline/keju/roster/frontier-sea events, currency-crisis event), not
				# a bug, but the player had no way to know that. Added a tooltip explaining it.
				tooltip = "topbar_tt_quarter_oow_tt"
				blockoverride "cell_1" { text = "topbar_tt_quarter_oow" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_national_total_from_oneshot_grants').GetValue|3+=]" }
			}
			cell_wealth_information = {
				blockoverride "text" {
					size = { 300 28 }
					align = center
					text = "topbar_tt_outgoings"
				}
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_aw" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_cost_administrator_wages_country').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_mw" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_cost_military_wages_country').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_ms" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_cost_military_supplies_country').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_ns" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_cost_navy_supplies_country').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_ws" }
				blockoverride "cell_2" { text = "[Player.MakeScope.GetVariable('INCOME_cost_welfare_spending').GetValue|3+=]" }
			}
			string_income_information = {
				blockoverride "cell_1" { text = "topbar_tt_outgoings_di" }
				blockoverride "cell_2" { text = "[GuiScope.SetRoot( Player.MakeScope ).ScriptValue('CURRENCY_national_debt_interest_actual_wealth_cost')|3+=]" }
			}
		}
	}
}

