########################################################################
# qing_art_patronage.gui — [#122] the Art Patronage panel (如意館 painters + 欽天監
# astronomy + the #390 Wenzhi cultural-patronage initiatives), opened from the Imperial
# Household window (gui/qing_household.gui, qing_art_patronage_open_panel_button).
#
# Surfaces the CONCRETE Jesuit painter (Castiglione, #121 — se_QING_WENZHI.txt) with a
# portrait card mirroring the Salt/Caravan/Hoppo/Opium commissioner cards, the astronomy
# bureau's research status, the existing Wenzhi patronage meter + 4 initiative buttons, and
# the new Suppress-the-Jesuits lever (#122). Icon reused from qing_hanlin.dds (the closest
# existing scholarly-institution asset — no bespoke art commissioned for this panel).
# Mirrors gui/qing_opium.gui's skeleton. TAB indentation throughout.
########################################################################

base_window = {
	name = "qing_art_patronage_panel"
	size = { 520 760 }
	allow_outside = yes
	movable = yes

	using = main_window_template

	state = {
		name = _show
		start_sound = { soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close" }
	}
	state = {
		name = _hide
		start_sound = { soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close" }
	}

	flowcontainer = {
		direction = vertical

		# HEADER
		widget = {
			size = { 520 48 }
			using = MainWindowHeaderBox
			blockoverride "Title_text" { text = "QING_ART_PATRONAGE_PANEL_TITLE" }
			blockoverride "FlagOrIcon" {
				icon = {
					texture = "gfx/interface/base_parts/yellow_button_color_200fs.dds"
					framesize = { 100 100 }
					frame = 6
					position = { -2 -2 }
					size = { 32 32 }
					modify_texture = {
						texture = "gfx/interface/icons/menu_buttons/qing_hanlin.dds"
						blend_mode = alphamultiply
					}
				}
			}
			blockoverride "White_buttons" {
				button_close = {
					onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets qing_art_patronage_panel')]"
					tooltip = "CLOSE"
					shortcut = "close_window"
				}
			}
		}

		# BODY
		margin_widget = {
			size = { 520 700 }
			margin = { 10 10 }

			scrollarea = {
				size = { 500 680 }
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = { using = VerticalScrollBar }
				using = VerticalScrollAreaCutOff
				scrollwidget = {
					flowcontainer = {
						direction = vertical
						spacing = 12

						# DESCRIPTION (wraps)
						textbox = {
							size = { 480 88 }
							multiline = yes
							using = BaseFontM
							using = Default_FontColor
							text = "QING_ART_PATRONAGE_PANEL_DESC"
						}

						# --- CASTIGLIONE / PAINTER CARD (郎世寧) — rendered via .GetCharacter when alive.
						flowcontainer = {
							visible = "[GetScriptedGui('qing_castiglione_alive').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
							spacing = 8
							margin = { 4 4 }
							cpt_button = {
								size = { 50 77 }
								datacontext = "[Player.MakeScope.Var('qing_castiglione_char').GetCharacter]"
							}
							flowcontainer = {
								direction = vertical
								spacing = 4
								textbox = {
									size = { 400 24 }
									using = BaseFontM
									using = Default_FontColor
									text = "QING_ART_PATRONAGE_CASTIGLIONE_TITLE"
								}
								textbox = {
									size = { 400 24 }
									using = BaseFontM
									using = Default_FontColor
									text = "[Player.MakeScope.Var('qing_castiglione_char').GetCharacter.GetName]"
								}
								flowcontainer = {
									datacontext = "[Player.MakeScope.Var('qing_castiglione_char').GetCharacter]"
									icon_and_text = {
										size = { 70 24 }
										blockoverride "Icon" { using = icon_civic }
										blockoverride "Text" { text = "[Character.GetFinesse]" }
										tooltip = "[Character.GetFinesseToolTip]"
									}
								}
							}
						}
						# once Castiglione has died, a quiet note instead of a blank space.
						textbox = {
							visible = "[Not( GetScriptedGui('qing_castiglione_alive').IsShown( GuiScope.SetRoot( Player.MakeScope ).End ) )]"
							size = { 460 24 }
							using = BaseFontS
							using = Default_FontColor
							text = "QING_ART_PATRONAGE_CASTIGLIONE_GONE"
						}

						# --- READ-OUTS: patronage meter + the astronomical bureau -----------
						flowcontainer = {
							direction = vertical
							spacing = 6
							layoutpolicy_horizontal = expanding
							using = background_widget
							margin = { 8 8 }
							textbox = {
								size = { 460 26 }
								using = BaseFontM
								using = Default_FontColor
								text = "QING_ART_PATRONAGE_STATE_TITLE"
							}
							# Cultural Patronage (文治, qing_wenzhi_patronage)
							flowcontainer = {
								spacing = 8
								textbox = {
									size = { 320 20 }
									using = BaseFontS
									using = Default_FontColor
									text = "QING_WENZHI_PATRONAGE_LABEL"
									tooltip = "QING_WENZHI_PATRONAGE_TT"
								}
								textbox = {
									size = { 90 20 }
									align = right
									using = BaseFontS
									using = Default_FontColor
									text = "[Player.MakeScope.GetVariable('qing_wenzhi_patronage').GetValue|0]"
								}
							}
							# 欽天監 the Imperial Astronomical Bureau — researched Y/N
							flowcontainer = {
								spacing = 8
								textbox = {
									size = { 320 20 }
									using = BaseFontS
									using = Default_FontColor
									text = "QING_ART_PATRONAGE_ASTRONOMY_LABEL"
									tooltip = "QING_ART_PATRONAGE_ASTRONOMY_TT"
								}
								textbox = {
									size = { 130 20 }
									align = right
									using = BaseFontS
									using = Default_FontColor
									visible = "[GetScriptedGui('qing_wenzhi_astronomy_researched').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
									text = "QING_ART_PATRONAGE_ASTRONOMY_YES"
								}
								textbox = {
									size = { 130 20 }
									align = right
									using = BaseFontS
									using = Default_FontColor
									visible = "[Not( GetScriptedGui('qing_wenzhi_astronomy_researched').IsShown( GuiScope.SetRoot( Player.MakeScope ).End ) )]"
									text = "QING_ART_PATRONAGE_ASTRONOMY_NO"
								}
							}
						}

						# --- LEVERS -----------------------------------------------------
						flowcontainer = {
							direction = vertical
							spacing = 6
							layoutpolicy_horizontal = expanding
							using = background_widget
							margin = { 8 8 }
							textbox = {
								size = { 460 26 }
								using = BaseFontM
								using = Default_FontColor
								text = "QING_ART_PATRONAGE_LEVERS_TITLE"
							}
							# [#390] fund the imperial workshops (造辦處)
							text_button_square_highlighted = {
								size = { 340 28 }
								datacontext = "[GetScriptedGui('qing_wenzhi_fund_workshops')]"
								blockoverride "Center_text" { text = "QING_WENZHI_WORKSHOPS_BTN"  max_width = 320 }
								blockoverride "On_click" {
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
								}
								tooltip = "QING_WENZHI_WORKSHOPS_TT"
							}
							# [#390] commission the painting academy (如意館)
							text_button_square_highlighted = {
								size = { 340 28 }
								datacontext = "[GetScriptedGui('qing_wenzhi_commission_painting')]"
								blockoverride "Center_text" { text = "QING_WENZHI_PAINTING_BTN"  max_width = 320 }
								blockoverride "On_click" {
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
								}
								tooltip = "QING_WENZHI_PAINTING_TT"
							}
							# [fix, task #5 2026-08-16] Convene the Complete Library / Make a Southern
							# Inspection Tour REMOVED from here -- duplicated with qing_household.gui, which
							# is their correct home (both are Imperial Household levers). Fund the Imperial
							# Workshops and Commission the Painting Academy stay here (Art Patronage's own).
							# [#122] SUPPRESS THE JESUITS (禁教) — shown only while a living Jesuit
							# court artist actually serves.
							text_button_square_highlighted = {
								visible = "[GetScriptedGui('qing_wenzhi_suppress_jesuits').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
								size = { 340 28 }
								datacontext = "[GetScriptedGui('qing_wenzhi_suppress_jesuits')]"
								blockoverride "Center_text" { text = "QING_ART_PATRONAGE_SUPPRESS_BTN"  max_width = 320 }
								blockoverride "On_click" {
									enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
									onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
								}
								tooltip = "QING_ART_PATRONAGE_SUPPRESS_TT"
							}
						}
					}
				}
			}
		}
	}
}
