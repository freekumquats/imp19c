			widget = { size = { 0 10 } }
			margin_widget = {
				size = { 0 50 }
				layoutpolicy_horizontal = expanding
				textbox = {
					parentanchor = hcenter
					position = { 0 10 }
					using = BaseFontM
					using = Default_FontColor
					text = "qing_friction_report_count"
					autoresize = yes
				}
			}
		}
	}
}

# ======================================================================
# [#35] Military Supplies Ledger window — scrollable list of provinces producing
# a military-supply good (munitions/rifles/naval_supplies), with the country
# income vs consumption totals in the footer. Read-only. Clones the crop-report shape.
# ======================================================================
# ======================================================================
# [#45] Military Supplies Ledger window — a COMPREHENSIVE per-good input table (produced vs
# consumed each quarter) for all six military-supply goods: munitions (early/late), artillery,
# clothing, pharmaceuticals, construction. NOT a province list (the old version listed only
# provinces whose trade_good was a military good — which at 1763 start was just Beijing's rifles,
# and clothing/pharma/construction/artillery are demand-fulfilled from stockpiles, never a province
# trade_good, so a province list could never show them). Fixed rows, always fully populated, read
# from the MILITARY_supplies_prod_* / MILITARY_supplies_country_* svalues (the same ones the #34/#44
# topbar breakdown uses). Footer = realm income / consumption / stockpile. Read-only.
# ======================================================================
base_sub_window = {
	name = "qing_milsupply_report_window"
	# [#57] taller (520 -> 680) to fit the new per-state production breakdown section beneath the
	# per-good totals table, and wider (430 -> 620, matching the admin report) so the per-state
	# 4-column row (state + munitions + clothing + naval) fits without clipping.
	size = { 620 680 }
	position = { 387 145 }
	movable = yes

	blockoverride "Title_text" { text = "qing_milsupply_report_title" }

	blockoverride "White_buttons"
	{
		button_close = {
			tooltip = "CLOSE"
			onclick = "[ExecuteConsoleCommand('gui.ClearWidgets qing_milsupply_report_window')]"
		}
	}

	margin_widget = {
		size = { 100% 100% }

		vbox = {
			parentanchor = hcenter
			margin_top = 45
			margin_bottom = 15
			spacing = 2

			# column header row
			margin_widget = {
				size = { 400 24 }
				hbox = {
					size = { 100% 100% }
					spacing = 6
					textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_good"  align = left|vcenter }
					textbox = { size = { 90 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_prod"  align = right|vcenter  tooltip = "qing_milsupply_col_prod_tt" }
					textbox = { size = { 90 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_cons"  align = right|vcenter  tooltip = "qing_milsupply_col_cons_tt" }
				}
			}

				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_early_munitions"  align = left|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#Y [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_prod_early_munitions')|2]#!"  align = right|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_early_munitions')|2]#!"  align = right|vcenter }
					}
				}
				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_late_munitions"  align = left|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#Y [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_prod_late_munitions')|2]#!"  align = right|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_late_munitions')|2]#!"  align = right|vcenter }
					}
				}
				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_artillery"  align = left|vcenter }
						# [#45 review-fix] artillery PRODUCTION is intentionally not modelled (the income
						# svalues cover only munitions/clothing/pharma/construction — INCOME_svalues.txt:969);
						# there is no MILITARY_supplies_prod_early_artillery. Show an honest dash, not a
						# broken ScriptValue. Consumption IS modelled, so the Consumed cell is real.
						textbox = { size = { 90 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_not_modelled"  align = right|vcenter  tooltip = "qing_milsupply_not_modelled_tt" }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_early_artillery')|2]#!"  align = right|vcenter }
					}
				}
				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_clothing"  align = left|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#Y [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_prod_clothing')|2]#!"  align = right|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_clothing')|2]#!"  align = right|vcenter }
					}
				}
				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_pharmaceuticals"  align = left|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#Y [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_prod_pharmaceuticals')|2]#!"  align = right|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_pharmaceuticals')|2]#!"  align = right|vcenter }
					}
				}
				margin_widget = {
					size = { 400 28 }
					hbox = {
						size = { 100% 100% }
						spacing = 6
						textbox = { size = { 200 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_good_construction"  align = left|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#Y [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_prod_construction')|2]#!"  align = right|vcenter }
						textbox = { size = { 90 100% }  using = BaseFontS  text = "#R [GuiScope.SetRoot( Player.MakeScope ).ScriptValue('MILITARY_supplies_country_construction')|2]#!"  align = right|vcenter }
					}
				}

			widget = { size = { 0 10 } }

			# [#57] PER-STATE production breakdown — which states produce which supply good + how much.
			textbox = {
				parentanchor = hcenter
				using = BaseFontS
				using = Default_FontColor
				text = "qing_milsupply_bystate_header"
				align = center
			}
			margin_widget = {
				size = { 560 22 }
				hbox = {
					size = { 100% 100% }
					margin_left = 30
					spacing = 6
					textbox = { size = { 220 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_state"      align = left|vcenter }
					textbox = { size = { 90 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_munitions"  align = right|vcenter }
					textbox = { size = { 90 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_clothing"   align = right|vcenter }
					textbox = { size = { 90 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_milsupply_col_naval"      align = right|vcenter }
				}
			}
			scrollarea = {
				size = { 560 0 }
				layoutpolicy_vertical = expanding
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = { using = VerticalScrollBar }
				using = VerticalScrollAreaCutOff

				textbox = {
					visible = "[GetScriptedGui('qing_report_milsupply_empty').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
					size = { 540 60 }
					parentanchor = hcenter
					multiline = yes
					using = BaseFontS
					using = Default_FontColor
					text = "qing_milsupply_bystate_empty"
					align = center
				}

				scrollwidget = {
					dynamicgridbox = {
						datamodel = "[Player.MakeScope.GetList('qing_milsupply_report_states')]"
						item = {
							margin_widget = {
								size = { 556 28 }

								goto_button = {
									size = { 26 26 }
									parentanchor = vcenter
									tooltip = "go_to"
									blockoverride "On_click" {
										onclick = "[OnClickOnProvince(Scope.GetState.GetCapital)]"
										onmousehierarchyenter = "[SetHighlightArea(Scope.GetState.GetArea)]"
										onmousehierarchyleave = "[ClearHighlightColors]"
									}
								}

								margin_widget = {
									size = { 100% 100% }
									margin_left = 30

									hbox = {
										size = { 100% 100% }
										spacing = 6
										textbox = { size = { 220 100% }  using = BaseFontS  using = Default_FontColor  text = "[Scope.GetState.GetName]"  align = left|vcenter }
										textbox = { size = { 90 100% }   using = BaseFontS  text = "#Y [Scope.GetState.MakeScope.GetVariable('qing_milsup_rep_munitions').GetValue|0]#!"  align = right|vcenter }
										textbox = { size = { 90 100% }   using = BaseFontS  text = "#Y [Scope.GetState.MakeScope.GetVariable('qing_milsup_rep_clothing').GetValue|0]#!"   align = right|vcenter }
										textbox = { size = { 90 100% }   using = BaseFontS  text = "#Y [Scope.GetState.MakeScope.GetVariable('qing_milsup_rep_naval').GetValue|0]#!"      align = right|vcenter }
									}
								}
							}
						}
					}
				}
			}

			widget = { size = { 0 10 } }

			# footer — realm income / consumption / stockpile totals
			# [#57] fixed-width centered footer (was autoresize+hcenter+position — the same left-spill
			# anti-pattern fixed in the admin report at #56).
			margin_widget = {
				size = { 100% 90 }

				textbox = {
					parentanchor = hcenter
					size = { 400 90 }
					max_width = 400
					using = BaseFontM
					using = Default_FontColor
					text = "qing_milsupply_report_totals"
					multiline = yes
					align = center
				}
			}
		}
	}
}

# ======================================================================
# [#36 / #32] Administrative Capacity window — scrollable list of governorship-states
# with admin PROVIDED / REQUIRED / available and yamen + district counts; a per-state
# deficit marker; the country supplied / required / available totals in the footer.
# The yamen count column makes the yamen -> admin-capacity link (#32) legible. Read-only.
# ======================================================================
base_sub_window = {
	name = "qing_admin_report_window"
	# [#55] widened 540 -> 620 so the 衙門 (yamen) and Dist columns and their data fit without
	# being clipped off the right edge (old total col width ~530 exceeded the 540 frame).
	size = { 620 650 }
	position = { 387 145 }
	movable = yes

	blockoverride "Title_text" { text = "qing_admin_report_title" }

	blockoverride "White_buttons"
	{
		button_close = {
			tooltip = "CLOSE"
			onclick = "[ExecuteConsoleCommand('gui.ClearWidgets qing_admin_report_window')]"
		}
	}

	margin_widget = {
		size = { 100% 100% }

		vbox = {
			parentanchor = hcenter
			margin_top = 45
			margin_bottom = 15

			# column header row
			# [#55] header widened 522 -> 602 and margin_left 36 -> 30 to MATCH the data rows
			# (rows use margin_left 30); the old 6px mismatch shifted headers off their columns.
			# [BUG-A 2026-08-05] 602 was WRONG: in a 620 window the base_sub_window frame border
			# (spriteborder 19) overlapped both edges (only (620-602)/2=9px margin < 19px frame), so the
			# Dist column clipped off the right — the SAME 9px gap the pre-fix 522-in-540 had, which is why
			# #55 "looked identical." Columns total only ~496px, so drop to 560 (matching the proven
			# milsupply report #57: 560-wide boxes in a 620 window = 30px margin, clears the frame).
			margin_widget = {
				size = { 560 24 }
				hbox = {
					size = { 100% 100% }
					margin_left = 30
					spacing = 6
					textbox = { size = { 150 100% }  using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_state"  align = left|vcenter }
					textbox = { size = { 66 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_prov"   align = right|vcenter  tooltip = "qing_admin_report_col_prov_tt" }
					textbox = { size = { 66 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_req"    align = right|vcenter  tooltip = "qing_admin_report_col_req_tt" }
					textbox = { size = { 66 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_avail"  align = right|vcenter  tooltip = "qing_admin_report_col_avail_tt" }
					textbox = { size = { 44 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_yamen"  align = right|vcenter  tooltip = "qing_admin_report_col_yamen_tt" }
					textbox = { size = { 44 100% }   using = BaseFontS  using = Default_FontColor  text = "qing_admin_report_col_dist"   align = right|vcenter  tooltip = "qing_admin_report_col_dist_tt" }
				}
			}

			scrollarea = {
				size = { 560 0 }
				layoutpolicy_vertical = expanding
				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = { using = VerticalScrollBar }
				using = VerticalScrollAreaCutOff

				textbox = {
					visible = "[GetScriptedGui('qing_report_admin_empty').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
					size = { 490 80 }
					parentanchor = hcenter
					multiline = yes
					using = BaseFontS
					using = Default_FontColor
					text = "qing_admin_report_empty"
					align = center
				}

				scrollwidget = {
					dynamicgridbox = {
						datamodel = "[Player.MakeScope.GetList('qing_admin_report_states')]"
						item = {
							margin_widget = {
								size = { 556 30 }

								goto_button = {
									size = { 26 26 }
									parentanchor = vcenter
									tooltip = "go_to"
									blockoverride "On_click" {
										onclick = "[OnClickOnProvince(Scope.GetState.GetCapital)]"
										onmousehierarchyenter = "[SetHighlightArea(Scope.GetState.GetArea)]"
										onmousehierarchyleave = "[ClearHighlightColors]"
									}
								}

								margin_widget = {
									size = { 100% 100% }
									margin_left = 30

									hbox = {
										size = { 100% 100% }
										spacing = 6

										textbox = {
											size = { 150 100% }
											using = BaseFontS
											using = Default_FontColor
											text = "[Scope.GetState.GetName]"
											align = left|vcenter
										}
										# provided capacity (from this state's yamens + districts + capital share)
										textbox = {
											size = { 66 100% }
											using = BaseFontS
											using = Default_FontColor
											text = "[Scope.GetState.MakeScope.GetVariable('qing_admin_rep_provided').GetValue|0]"
											align = right|vcenter
										}
										textbox = {
											size = { 66 100% }
											using = BaseFontS
											using = Default_FontColor
											text = "[Scope.GetState.MakeScope.GetVariable('qing_admin_rep_required').GetValue|0]"
											align = right|vcenter
										}
										# available = provided - required. RED when this state is in deficit
										# (qing_report_admin_state_deficit gate: available < 0), else green surplus.
										textbox = {
											visible = "[GetScriptedGui('qing_report_admin_state_deficit').IsShown( GuiScope.SetRoot( Scope.GetState.MakeScope ).End )]"
											size = { 66 100% }
											using = BaseFontS
											text = "#R [Scope.GetState.MakeScope.GetVariable('qing_admin_rep_available').GetValue|0]#!"
											align = right|vcenter
										}
										textbox = {
											visible = "[Not( GetScriptedGui('qing_report_admin_state_deficit').IsShown( GuiScope.SetRoot( Scope.GetState.MakeScope ).End ) )]"
											size = { 66 100% }
											using = BaseFontS
											text = "#G [Scope.GetState.MakeScope.GetVariable('qing_admin_rep_available').GetValue|0]#!"
											align = right|vcenter
										}
										textbox = {
											size = { 44 100% }
											using = BaseFontS
											using = Default_FontColor
											text = "[Scope.GetState.MakeScope.GetVariable('qing_admin_rep_yamens').GetValue|0]"
											align = right|vcenter
										}
										textbox = {
											size = { 44 100% }
											using = BaseFontS
											using = Default_FontColor
											text = "[Scope.GetState.MakeScope.GetVariable('qing_admin_rep_districts').GetValue|0]"
											align = right|vcenter
										}
									}
								}
							}
						}
					}
				}
			}

			widget = { size = { 0 10 } }

			# footer — country supplied / required / available totals
			# [#56] the footer text hung off the LEFT of the window: a MULTILINE textbox with
			# autoresize=yes + parentanchor=hcenter + position={0 8} mispositions (autoresize sizes the
			# box to its widest line, then hcenter+position push it out of frame). FIX: fixed width inside
			# the 620 window, center the TEXT (align=center), wrap via max_width, drop autoresize/position.
			# Text-wrap rule: multiline needs a fixed width to stay contained.
			margin_widget = {
				size = { 100% 130 }

				textbox = {
					parentanchor = hcenter
					size = { 580 130 }
					max_width = 580
					using = BaseFontM
					using = Default_FontColor
					text = "qing_admin_report_totals"
					multiline = yes
					align = center
				}
			}
		}
	}
}
