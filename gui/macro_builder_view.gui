@mincategorybuttonwidth = 61
@maxcategorybuttonwidth = 61
@mincategorybuttonheight = 42
@maxcategorybuttonheight = 42
@sidemargins = 42
@topmargins = 12
@window_width = 512
@window_height = 632
@windowwidthminusmargin = 482

####################
### MAIN WINDOW
####################

base_window = {
	gfxtype = windowgfx
	name = "macro_builder_view"
	parentanchor = top|left
	widgetanchor = top|left
	size = { @window_width @window_height }
	using = main_window_template
	state = {
		name = _show
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
	}
	state = {
		name = _hide
		start_sound = {
			soundeffect = "event:/SFX/UI/Generic/2.0/sfx_ui_window_tab_close"
		}
	}

	####################
	### MAIN HEADER
	####################

	vbox = {
		widget = {
			size = { @window_width 12 }
			using = MainWindowHeaderLine
		}
		margin_widget = {
			size = { @window_width 58 }
			layoutpolicy_horizontal = expanding
			hbox = { 
				layoutpolicy_vertical = preferred
				layoutpolicy_horizontal = expanding
				spacing = -2
				margin_widget = {
					using = MainWindowHeaderContentLeft
					blockoverride "Title_text" { text = "MACRO_BUILDER_TITLE"  }
					blockoverride "FlagOrIcon"
					{
						icon = {
							using = gold_background
							size = { 32 32 }
							modify_texture = {
								texture = "gfx/interface/icons/menu_buttons/macrobuilder.dds"
								blend_mode = alphamultiply
							}
						}
					}
				}
				flowcontainer = {
					spacing = 2
					datamodel = "[MacroBuilderView.GetPages]"
					item = {
						category_tab = {
							blockoverride "MinSize" { size = { @mincategorybuttonwidth @mincategorybuttonheight } }
							blockoverride "MaxSize" { size = { @maxcategorybuttonwidth @maxcategorybuttonheight } }
							blockoverride "ButtonMinSizeOverride" { size = { 60 22 } }
							blockoverride "MinVisible" { visible = "[Not( MacroBuilderPage.IsActive )]" }
							blockoverride "MaxVisible" { visible = "[MacroBuilderPage.IsActive]" }
							######## Shared Overrides
							blockoverride "Center_text" { visible = no }
							blockoverride "Center_text_and_icon" { visible = yes }
							blockoverride "Button_text" { visible = no }
							blockoverride "Icon"
							{
								texture = "[MacroBuilderPage.GetIconTexture]" 
							}
							######## Small Button Overrides
							blockoverride "ClickFunction"
							{
								onclick = "[MacroBuilderPage.OnActivate]"
							}
						}
						
					}
				}
				margin_widget = {
					using = MainWindowHeaderContentRight
					blockoverride "White_buttons" 
					{
						button_back = { 
							shortcut = "previous_window"
							onclick = "[MacroBuilderView.OnPrevious]"
							tooltip = "PREVIOUS_MACRO_BUILDER_VIEW"
						}
						
						button_close = {
							onclick = "[MacroBuilderView.OnClose]"
							tooltip = "CLOSE"
							shortcut = "close_window"
						}
					}
				}
			}
		}
		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding

			#################
			### SUB HEADER 
			#################

			margin_widget = {
				size = { 0 32 }
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = fixed
				margin = { 14 0 }
				sub_header = {
					size = { 480 32 }
					tooltip = [MacroBuilderView.GetActivePage.GetTooltip]
					blockoverride "Title_text"
					{
						text = [MacroBuilderView.GetActivePage.GetName]
					}
				}
			}


			####################################			
			### LIST - WHAT TO BUILD (STEP 1)
			####################################

			margin_widget = {
				size = { 0 510 }
				name = "build_in_province"
				layoutpolicy_vertical = fixed
				layoutpolicy_horizontal = expanding
				margin = { 18 0 }
				margin_top = 8
				widget = {
					size = { 100% 100% }
					icon = {
						size = { 100 100 }
						#using = gold_background
					}
					visible = "[And(And(Not(MacroBuilderView.IsLayoutActive('trade_goods')), Not(MacroBuilderView.GetBuildInProvince.IsInProvinceMode)), Not(MacroBuilderView.IsLayoutActive('build_in_province_naval_units')))]"
                    # [BT-L 2026-07-25] wrap the building-section stack in a scrollarea so the lower sections
                    # (Public Works, Military, Urban Districts, Foreign) are reachable — the fixed 510px column
                    # clipped everything past ~Military (Foreign ran off the panel bottom). Mirrors province_window.gui:4053.
                    scrollarea = {
                    	size = { @windowwidthminusmargin 500 }
                    	scrollbarpolicy_horizontal = always_off
                    	scrollbar_vertical = { using = VerticalScrollBar }
                    	using = VerticalScrollAreaCutOff
                    	scrollwidget = {
                    building_box = {
                        blockoverride "PortItems" {
                            macro_build_item_port = { }
                            macro_build_item_river_port = { }
                        }
                        blockoverride "EducationItems" {
                            macro_build_item_school = { }
                            macro_build_item_university = { }
                        }
                        # [BT 2026-07-27 #2] Split across two stacked rows so 8 items don't run off the
                        # right edge (mirrors the province window). Row 1 = the two generic works;
                        # Row 2 = the six Qing state production works.
                        blockoverride "IndustrialItems" {
                            macro_build_item_industrial_estate = { }
                            macro_build_item_resource_gathering_operation = { }
                            # [BT 2026-07-26 #91] row_manufactory / row_plantation REMOVED — they are
                            # rest-of-world buildings (potential = NOT chinese_group) and should not
                            # show in the Qing player's macro builder; the Qing works below replace them.
                        }
                        blockoverride "IndustrialItemsRow2" {
                            # [BT 2026-07-26 #89] the six Qing state production works — each name-matches
                            # its building def and is listed in the macro config allowlist
                            # (gfx/interface/macro_builder/config/00_default.txt); only Chinese-culture
                            # nations can raise them, per the allow-gate.
                            macro_build_item_qing_silk_filature_building = { }
                            macro_build_item_qing_porcelain_kiln_building = { }
                            macro_build_item_qing_tea_workshop_building = { }
                            macro_build_item_qing_cotton_workshop_building = { }
                            macro_build_item_qing_salt_yard_building = { }
                            macro_build_item_qing_opium_poppy_farm_building = { }
                        }
                        blockoverride "InfrastructureItems" {
                            macro_build_item_sewer_infrastructure = { }
                            macro_build_item_hospital = { }
                            macro_build_item_canal = { }
                            macro_build_item_railway_upgrade = { }
                            macro_build_item_depot = { }
                        }
                        # [BT-L 2026-07-25] PUBLIC WORKS section — was MISSING from the macro builder (only
                        # province_window.gui had it), so the Board of Works buildings could not be macro-built.
                        # Mirrors province_window.gui:4086.
                        blockoverride "PublicWorksItems" {
                            macro_build_item_qing_dike_building = { }
                            macro_build_item_qing_canal_depot_building = { }
                            macro_build_item_qing_wall_section_building = { }
                            macro_build_item_qing_granary_building = { }
                            macro_build_item_qing_capital_granary_building = { }   # [#86] 京倉 Metropolitan Granary — capital-only via its potential
                            macro_build_item_qing_yamen_building = { }   # [#31 2026-08-07] the yamen is a
                            # civil-administration office, not a scholarship building — moved here from
                            # ScholarshipItems (user boot-test #31 follow-up).
                            # [BT 2026-07-27 #5] The two capstone monuments (qing_great_wall_building /
                            # qing_grand_canal_building) are EVENT-RAISED only and deliberately omitted
                            # from the macro builder's config allowlist (gfx/interface/macro_builder/
                            # config/00_default.txt), so their item widgets are not instantiated here.
                        }
                        blockoverride "MilitaryItems" {
                            macro_build_item_fortress_building = { }
                            macro_build_item_arsenal_building = { }
                            macro_build_item_military_depot_building = { }   # [#31]
                        }
                        blockoverride "UrbanDistrictsItems" {
                            macro_build_item_commerce_district = { }
                            macro_build_item_administration_district = { }
                            macro_build_item_residential_district = { }
                            macro_build_item_cultural_district = { }
                        }
                        # [BT-L 2026-07-25] FOREIGN section — was MISSING from the macro builder, so the
                        # Foreign header rendered with no buildings under it (boot shot 011520). Mirrors
                        # province_window.gui:4106 (Christian-mission + foreign-concession buildings).
                        # [#31 2026-08-07] Foreign now holds 9 items — split across the template's two rows
                        # (ForeignItems + ForeignItemsRow2) so they don't overflow the fixed ~484px scrollarea
                        # and clip off the right edge (flowcontainer does not auto-wrap). Mirrors the Industrial
                        # / ModernIndustry two-row pattern.
                        blockoverride "ForeignItems" {
                            macro_build_item_qing_mission_underground_building = { }
                            macro_build_item_qing_mission_public_building = { }
                            macro_build_item_qing_foreign_concession_building = { }
                            macro_build_item_qing_frontier_colony_building = { }   # [#31]
                            macro_build_item_qing_frontier_fort_building = { }   # [#31]
                        }
                        blockoverride "ForeignItemsRow2" {
                            macro_build_item_qing_embassy_building = { }   # [#31]
                            macro_build_item_qing_foreign_works_building = { }   # [#31]
                            macro_build_item_qing_mission_cathedral_building = { }   # [#31]
                            macro_build_item_qing_treaty_port_building = { }   # [#31]
                        }
                        # [buildings-research 2026-07-27] new build sections (scholarship / religion /
                        # agriculture / commerce / modern industry). Each item name-matches its def;
                        # non-eligible provinces simply show no match and the section row collapses.
                        blockoverride "GarrisonItems" {
                            macro_build_item_qing_banner_garrison_building = { }
                            macro_build_item_qing_horse_pasture_building = { }
                            macro_build_item_qing_green_standard_post_building = { }
                            macro_build_item_qing_coastal_battery_building = { }
                            macro_build_item_qing_military_colony_building = { }
                        }
                        blockoverride "ScholarshipItems" {
                            macro_build_item_qing_examination_hall_building = { }
                            macro_build_item_qing_tongwen_guan_building = { }
                            macro_build_item_qing_imperial_university_building = { }
                            macro_build_item_qing_shuyuan_building = { }   # [#31]
                        }
                        blockoverride "ReligionItems" {
                            macro_build_item_qing_confucian_temple_building = { }
                            macro_build_item_qing_gelug_monastery_building = { }
                            macro_build_item_qing_great_mosque_building = { }
                        }
                        blockoverride "AgricultureItems" {
                            macro_build_item_qing_river_conservancy_building = { }
                            macro_build_item_qing_karez_building = { }
                            macro_build_item_qing_fishpond_dyke_building = { }
                            macro_build_item_qing_polder_building = { }
                            macro_build_item_qing_community_granary_building = { }
                            macro_build_item_new_world_farmstead_building = { }
                        }
                        # [#31 2026-08-07] Commerce now holds 9 items — split across two rows (CommerceItems +
                        # CommerceItemsRow2, the latter added to the building_box template) so they don't overflow
                        # the fixed scrollarea width. Mirrors the Foreign / Industrial / ModernIndustry two-row pattern.
                        blockoverride "CommerceItems" {
                            macro_build_item_qing_mint_building = { }
                            macro_build_item_qing_draft_bank_building = { }
                            macro_build_item_qing_guild_hall_building = { }
                            macro_build_item_qing_tribute_depot_building = { }
                            macro_build_item_qing_likin_station_building = { }
                        }
                        blockoverride "CommerceItemsRow2" {
                            macro_build_item_qing_imperial_bank_building = { }
                            macro_build_item_qing_telegraph_building = { }
                            macro_build_item_qing_customs_house_building = { }   # [#31]
                            macro_build_item_qing_oasis_bazaar_building = { }   # [#31]
                        }
                        blockoverride "ModernIndustryItems" {
                            macro_build_item_IND_coal_mine_building = { }
                            macro_build_item_IND_blast_furnace_building = { }
                            macro_build_item_IND_electric_plant_building = { }
                            macro_build_item_IND_gasworks_building = { }
                            macro_build_item_qing_steel_works_building = { }
                            macro_build_item_qing_selfstr_wonder_building = { }   # [#31]
                        }
                        blockoverride "ModernIndustryItemsRow2" {
                            macro_build_item_qing_textile_mill_building = { }
                            macro_build_item_qing_machine_works_building = { }
                            macro_build_item_qing_navy_yard_building = { }
                            macro_build_item_qing_coal_mine_building = { }
                        }
                    }
                    	}
                    }
				}
				scrollarea = {
					size = { @windowwidthminusmargin 100% }
					scrollbarpolicy_horizontal = always_off
					using = VerticalScrollAreaCutOff
					scrollbar_vertical = {
						using = VerticalScrollBar
					}
					visible = "[And(MacroBuilderView.IsLayoutActive('build_in_province_naval_units'), Not(MacroBuilderView.GetBuildInProvince.IsInProvinceMode))]"
					
					scrollwidget = {
						fixedgridbox = {
							datamodel = "[MacroBuilderView.GetBuildInProvinceModel]"
							size = { 490 500 }
							addcolumn = 480
							addrow = 44
							
							item = {
								widget = {
									size = { 470 40 }
									hbox = {
										spacing = 6
										margin_top = 5
										icon_card_macro = {
											size = { 40 40 }
											blockoverride "Icon" { 
												texture = "[MacroBuilderProvinceBuildable.GetIconTexture]" 
												size = { 32 32 }
											}
											tooltip = "[MacroBuilderProvinceBuildable.GetTooltip]"
										}
										
										widget = {
											size = { 302 34 }
											list_button = {
												size = { 100% 100% }
												tooltip = "[MacroBuilderProvinceBuildable.GetTooltip]"
												enabled = "[MacroBuilderProvinceBuildable.IsEnabled]"
												down = "[MacroBuilderProvinceBuildable.IsSelected]"
												blockoverride "On_click"
												{ 
													onclick = "[MacroBuilderProvinceBuildable.OnClick]"
												}
											}
											textbox = {
												text = "[MacroBuilderProvinceBuildable.GetName]"
												using = BaseFontM
												using = Default_FontColor
												parentanchor = vcenter
												align = left|nobaseline
												position = { 12 1 }
												autoresize = yes
											}
										}
										flowcontainer = {
											ignoreinvisible = yes
											button_info = {
												visible = "[EqualTo_string(MacroBuilderProvinceBuildable.GetName, Localize('brig'))]"
												onclick = "[GetVariableSystem.Set( 'wiki_page', 'brig_page' )]"
												onclick = "[GetVariableSystem.Set( 'wiki_ui', 'open' )]"
												tooltip = "brig"
											}
											button_info = {
												visible = "[EqualTo_string(MacroBuilderProvinceBuildable.GetName, Localize('medium_steamer'))]"
												onclick = "[GetVariableSystem.Set( 'wiki_page', 'medium_steamer_page' )]"
												onclick = "[GetVariableSystem.Set( 'wiki_ui', 'open' )]"
												tooltip = "medium_steamer"
											}
											button_info = {
												visible = "[EqualTo_string(MacroBuilderProvinceBuildable.GetName, Localize('screw_frigate'))]"
												onclick = "[GetVariableSystem.Set( 'wiki_page', 'screw_frigate_page' )]"
												onclick = "[GetVariableSystem.Set( 'wiki_ui', 'open' )]"
												tooltip = "screw_frigate"
											}
										}
										text_and_icon_price = {
											name = "cost"
											size = { 90 28 }
											tooltip = "MACRO_BUILDER_COST"
											blockoverride "LineVisibility"
											{
												visible = no
											}
										}
									}
								}
							}
						}
					}
				}
				margin_widget = {
					name = "province_mode"
					size = { 100% 100% }
					visible = "[And(MacroBuilderView.IsLayoutActive('build_in_province_with_list'), MacroBuilderView.GetBuildInProvince.IsInProvinceMode)]"
					datacontext = "[MacroBuilderView.GetBuildInProvince]"
					#margin_left = 8
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin_widget = {
							name = "sort_by"
							size = { 0 38 }
							layoutpolicy_horizontal = expanding
							margin = { 4 0 }

							flowcontainer = {
								spacing = 4
								
								text_button_sort = {
									size = { 212 0 }
									tooltip = "MACRO_BUILDER_SORT_PROVINCE_NAME_TT"
									
									blockoverride "Button_text" { text = "A_Z" }
									blockoverride "Icon" { 
										visible = no
									}
									blockoverride "On_click" { onclick = "[MacroBuilderBuildInProvince.SortProvinces('name')]" }
									blockoverride "DownState" { down = "[MacroBuilderBuildInProvince.IsProvincesSorted('name')]" }
								}
								
								fixedgridbox = {
									addcolumn = 62
									addrow = 32
									maxverticalslots = 1
									flipdirection = yes
									datamodel = "[MacroBuilderBuildInProvince.GetModificationHeaders]"
									
									item = {
										widget = {
											size = { 58 24 }
											text_button_sort = {
												size = { 58 0 }
												tooltip = "[ModificationItem.GetName]"
												visible = "[Not( ModificationItem.ShouldShowValue )]"
												blockoverride "Button_text" { visible = no }
												blockoverride "Icon" { 
													visible = yes
													texture = "[ModificationItem.GetIcon]"
												}
												blockoverride "On_click" { onclick = "[MacroBuilderBuildInProvince.SortProvinces(ModificationItem.GetKey)]" }
												blockoverride "DownState" { down = "[MacroBuilderBuildInProvince.IsProvincesSorted(ModificationItem.GetKey)]" }
											}
											text_button_sort = {
												size = { 58 0 }
												tooltip = "[ModificationItem.GetName]"
												visible = "[ModificationItem.ShouldShowValue]"
												blockoverride "Button_text" { visible = no }
												blockoverride "Icon" { 
													visible = yes
													texture = "[ModificationItem.GetIcon]"
												}
												blockoverride "On_click" { onclick = "[MacroBuilderBuildInProvince.SortProvincesByNewValue(ModificationItem.GetKey)]" }
												blockoverride "DownState" { down = "[MacroBuilderBuildInProvince.IsProvincesSortedByNewValue(ModificationItem.GetKey)]" }
											}
										}
									}
								}
								
							}
						}
						####################################
						### LIST - WHERE TO BUILD (STEP 2)
						####################################
						margin_widget = {
							size = { 0 474 }
							layoutpolicy_horizontal = expanding

							scrollarea = {
								size = { 478 400 }

								scrollbarpolicy_horizontal = always_off
								using = VerticalScrollAreaCutOff
								scrollbar_vertical = {
									using = VerticalScrollBar
								}
								
								scrollwidget = {
									fixedgridbox = {
										datamodel = "[MacroBuilderBuildInProvince.GetBuildableGlueItems]"
										size = { 380 460 }
										addcolumn = 466
										addrow = 35
										
										item = {
											widget = {
												size = { 100% 35 }
												text_button_square = {
													size = { 212 28 }
													position = { 4 0 }
													parentanchor = vcenter
													blockoverride "Center_text"
													{
														text = "[BuildableGlueItem.GetProvince.GetName]"
														autoresize = no
													}
													
													tooltip = "[BuildableGlueItem.GetProvinceTooltip]"
													enabled = "[And(BuildableGlueItem.CanBuild, GreaterThan_CFixedPoint(GuiScope.SetRoot(BuildableGlueItem.GetProvince.MakeScope).ScriptValue('JOBS_available_slots'), '(CFixedPoint)0' ) )]"
													# TODO: macro_builder_view scriptvalue trigger for can build with slots
													blockoverride "On_click"
													{
														onclick = "[BuildableGlueItem.OnClick]"
													}
													onmousehierarchyenter = "[SetHighlightProvince( BuildableGlueItem.GetProvince.GetId )]"
													onmousehierarchyleave = "[ClearHighlightColors]"
												}
												
												tag = {
													text = "[GuiScope.SetRoot(BuildableGlueItem.GetProvince.MakeScope).ScriptValue('JOBS_available_slots')|0]"
													parentanchor = vcenter
													position = { 230 2 }
													minimumsize = { 34 0 }
												}
													
												fixedgridbox = {	
													position = { 267 4 }
													addcolumn = 64
													addrow = 32
													maxverticalslots = 1
													flipdirection = yes
													
													datamodel = "[BuildableGlueItem.GetModifications]"
													
													item = {
														widget = {
															size = { 68 24 }
															parentanchor = vcenter
															position = { 230 2 }
															tag = {
																visible = "[Not( ModificationItem.ShouldShowValue )]"
																text = "[ModificationItem.GetDifferenceFormatted]"
																minimumsize = { 68 0 }
																maximumsize = { 68 999 }
																tooltip = "MACRO_BUILDER_MOD_ITEM_TT"
															}
															tag = {
																visible = "[ModificationItem.ShouldShowValue]"
																text = "[ModificationItem.GetNewValueFormatted|0]"
																minimumsize = { 68 0 }
																maximumsize = { 68 999 }
																tooltip = "MACRO_BUILDER_MOD_ITEM_TT"
																using = BaseFontS
															}
														}
													}
												}
											}
										}
									}
								}
							}	
						}
					}	
					allow_outside = yes
					margin_widget = {
						name = "back_button"
						size = { 100% 32 }
						parentanchor = bottom|left
						position = { 0 12 }
						margin = { 4 0 }

						text_button_square = {
							size = { 220 28 }
							parentanchor = hcenter|top
							blockoverride "Center_text"
							{
								text = "BACK"
							}
							blockoverride "On_click" 
							{
                                onclick = "[MacroBuilderBuildInProvince.OnBack]"
							}
						}
					}
				}
				allow_outside = yes
				###########################
				### TRADE GOODS
				###########################	
						

			}
			vbox = { layoutpolicy_vertical = expanding }
		}
	}	
}
